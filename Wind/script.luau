local uq = {};
local function gq(Y)
	local d = tostring(Y);
	while true do
		d, k = d:gsub("^(-?%d+)(%d%d%d)", "%1,%2");
		if k == 0 then
			break;
		end;
	end;
	return d;
end;
local zq = {};

-- Fetch the fruit stock list from the server. Advanced = true -> Mirage dealer.
local function FetchFruitStock(Advanced)
	local List = {};
	local ok, Res = pcall(function()
		return Q.Remotes.CommF_:InvokeServer("GetFruits", Advanced);
	end);
	if not ok or type(Res) ~= "table" then
		return List;
	end;
	for Y, d in pairs(Res) do
		if type(d) == "table" and d.OnSale == true and d.Name then
			table.insert(List, d.Name .. " - $" .. gq(d.Price));
		end;
	end;
	return List;
end;

-- Strip the " - $price" suffix so the buy remote gets a clean fruit name.
local function FruitName(Y)
	if type(Y) ~= "string" then
		return Y;
	end;
	return (Y:gsub("%s*%-%s*%$.*$", ""));
end;

